// Configuration Cloudflare du site. Astro la complète au build (point d'entrée, fichiers statiques, images).
// On y fixe seulement ce que la commande de prévisualisation des branches de test (wrangler preview)
// ne sait pas retrouver seule : l'identifiant de l'espace de stockage SESSION (Workers KV « pyrite-site-session »).
// Ce n'est pas un secret.
{
  "name": "pyrite-site",
  "compatibility_date": "2026-11-10",
  "kv_namespaces": [
    { "binding": "SESSION", "id": "d2c0283414574140a57583cdb3ec2547" }
  ],
  // Les prévisualisations n'héritent d'aucun stockage de la production : on leur redonne le même espace SESSION.
  "previews": {
    "kv_namespaces": [
      { "binding": "SESSION", "id": "d2c0283414574140a57583cdb3ec2547" }
    ]
  }
}
