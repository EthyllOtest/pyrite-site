---
// Page À propos : qui est Ewan, parcours, réalisation chez AXA, origine du nom, premiers retours.
// Le portrait et les retours sont partagés avec l'accueil (accueil.yaml).
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Diviseur from '../components/Diviseur.astro';
import Texte from '../components/Texte.astro';
import AFournir from '../components/AFournir.astro';
import AppelFinal from '../components/AppelFinal.astro';
import { rempli } from '../lib/texte';

const ap = (await getEntry('pages', 'a-propos'))!.data;
const acc = (await getEntry('pages', 'accueil'))!.data;
const portrait = acc.accompagnement;
const retours = (acc.retours ?? []).filter((r: any) => rempli(r.citation));
const etapes = (ap.parcours.etapes ?? []).filter((e: any) => rempli(e.texte));
const chiffres = (ap.realisation.chiffres ?? []).filter((c: any) => rempli(c.valeur));
---
<Base titre={ap.meta.titre} description={ap.meta.description}>
  <Section titreId="titre-apropos">
    <div class="presentation">
      {portrait.portrait
        ? <img src={portrait.portrait} alt={portrait.portraitAlt} width="360" height="440" />
        : <div class="emplacement-photo"><AFournir>portrait d'Ewan, traitement chaud et sobre, cadrage serré</AFournir></div>}
      <div class="pile pile-16">
        <p class="pyr-label">{ap.intro.label}</p>
        <h1 id="titre-apropos" class="t-titre-1">{ap.intro.titre}</h1>
        <Diviseur class="diviseur-court" />
        <Texte valeur={ap.intro.presentation} manque="présentation en 2 ou 3 phrases : qui vous êtes, ce que vous faites, pour qui" />
      </div>
    </div>
  </Section>

  <Section fond="releve" titreId="titre-parcours">
    <div class="pile pile-32">
      <h2 id="titre-parcours" class="t-titre-2">{ap.parcours.titre}</h2>
      <ol role="list" class="parcours">
        {etapes.length
          ? etapes.map((e: any) => <li class="parcours__etape"><span class="pyr-label">{e.dates}</span><p class="mesure">{e.texte}</p></li>)
          : [1, 2, 3].map(() => <li class="parcours__etape"><span class="pyr-label">[Dates]</span><AFournir bloc>étape du parcours : poste, structure, ce que vous y avez fait</AFournir></li>)}
      </ol>
    </div>
  </Section>

  <Section titreId="titre-realisation">
    <div class="pile pile-32">
      <div class="pile pile-16">
        <p class="pyr-label">{ap.realisation.label}</p>
        <h2 id="titre-realisation" class="t-titre-2">{ap.realisation.titre}</h2>
        <Texte valeur={ap.realisation.texte} manque="contexte et ce que vous avez fait, en 3 ou 4 phrases, sans logo AXA ni capture interne" />
      </div>
      {/* Sans chiffre vérifiable, la grille est masquée en ligne (repères visibles seulement en local). */}
      {(chiffres.length > 0 || import.meta.env.DEV) && (
        <div class="grille grille-3">
          {chiffres.length
            ? chiffres.map((c: any) => <div class="pile pile-8 filet-haut"><span class="t-chiffre">{c.valeur}</span><p>{c.libelle}</p></div>)
            : [1, 2, 3].map(() => <div class="pile pile-8 filet-haut"><span class="t-chiffre">[chiffre]</span><AFournir bloc>chiffre vérifiable et son libellé (grille invisible en ligne tant qu'elle est vide)</AFournir></div>)}
        </div>
      )}
    </div>
  </Section>

  <Section fond="releve" titreId="titre-nom">
    <div class="pile pile-16">
      <p class="pyr-label">{ap.nom.label}</p>
      <h2 id="titre-nom" class="t-titre-2">{ap.nom.titre}</h2>
      <p class="mesure">{ap.nom.texte}</p>
      <p class="t-accroche">Tout ce qui brille n'est pas or.</p>
    </div>
  </Section>

  {(retours.length > 0 || import.meta.env.DEV) && (
    <Section titreId="titre-retours">
      <div class="pile pile-32">
        <h2 id="titre-retours" class="t-titre-2">Premiers retours</h2>
        <div class="grille grille-2">
          {retours.length
            ? retours.map((r: any) => (
                <figure class="pile pile-16 filet-haut">
                  <blockquote class="t-accroche" style="font-size: 20px">« {r.citation} »</blockquote>
                  <figcaption class="pyr-label">{r.prenom} · {r.fonction}</figcaption>
                </figure>))
            : [1, 2].map(() => <AFournir bloc>retour d'un testeur, avec son accord : citation, prénom, fonction (section invisible en ligne tant qu'elle est vide)</AFournir>)}
        </div>
      </div>
    </Section>
  )}

  <AppelFinal titre={ap.final.titre} texte={ap.final.texte} />
</Base>
