---
// Pyrite de la section « Or ou pyrite » : décorative, masquée aux lecteurs d'écran.
// Par défaut (et sur mobile, sans WebGL ou avec « réduire les animations ») : image fixe tirée du rendu 3D,
// la face pyrite à côté de la face or. Sur ordinateur, quand la section approche, le modèle 3D
// (public/modeles/pyrite.glb, affiché par src/scripts/cristal-3d.js avec Three.js) prend sa place
// et fait un demi-tour au défilement : face pyrite d'abord, face or ensuite.
// Exception au design system (pas de cristal ni de 3D), décidée par Ewan le 15/11/2026, modèle scanné depuis le 16/11/2026.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="cristal" data-cristal data-modele={`${base}/modeles/pyrite.glb`} aria-hidden="true">
  <div class="cristal__fixe">
    <img src={`${base}/images/pyrite-or.webp`} width="640" height="400" alt="" loading="lazy" decoding="async" />
    <span>Pyrite</span>
    <span>Or</span>
  </div>
</div>

<script>
  // Charge la pyrite 3D seulement quand la section approche de l'écran, sur ordinateur, avec les animations permises.
  const reduit = window.matchMedia('(prefers-reduced-motion: reduce)');
  const ordinateur = window.matchMedia('(min-width: 768px)');

  document.querySelectorAll<HTMLElement>('[data-cristal]').forEach((boite) => {
    if (reduit.matches || !ordinateur.matches || !('IntersectionObserver' in window)) return;
    const section = boite.closest('section') ?? boite;
    const modele = boite.dataset.modele ?? '';

    const approche = new IntersectionObserver(async (entrees) => {
      if (!entrees.some((e) => e.isIntersecting)) return;
      approche.disconnect();
      try {
        const { demarrer } = await import('../scripts/cristal-3d.js');
        const cristal = await demarrer(boite, modele);
        if (!cristal) return; // Pas de WebGL : l'image fixe reste.
        boite.classList.add('est-3d');

        // Progression du demi-tour : 0 quand l'objet vient d'entrer en entier par le bas de l'écran (face pyrite),
        // 1 quand le bas de la section atteint le bas de l'écran (face or), ou plus tôt si l'objet
        // approche de l'en-tête : il reste ainsi visible pendant tout le demi-tour. Suit le défilement dans les deux sens.
        const progression = () => {
          const h = window.innerHeight;
          const c = boite.getBoundingClientRect();
          const s = section.getBoundingClientRect();
          const course = Math.min(s.bottom - c.bottom, h - c.height - 110);
          return (h - c.bottom) / Math.max(course, 1);
        };
        let enAttente = false;
        const dessiner = () => { enAttente = false; cristal.rendre(progression()); };
        const demander = () => { if (!enAttente) { enAttente = true; requestAnimationFrame(dessiner); } };

        // Pause : on n'écoute le défilement que tant que la section est visible.
        new IntersectionObserver(([e]) => {
          if (e.isIntersecting) { window.addEventListener('scroll', demander, { passive: true }); demander(); }
          else window.removeEventListener('scroll', demander);
        }).observe(section);
        window.addEventListener('resize', demander);
      } catch {
        // En cas d'échec du chargement, l'image fixe reste affichée.
      }
    }, { rootMargin: '600px 0px' });
    approche.observe(section);
  });
</script>

<style>
  .cristal { position: relative; width: 100%; max-width: 280px; aspect-ratio: 1; display: grid; place-items: center; }
  .cristal :global(.cristal__toile) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .cristal.est-3d .cristal__fixe { visibility: hidden; }

  /* Image fixe : les deux faces côte à côte, chacune avec son nom dessous. */
  .cristal__fixe { width: 100%; display: grid; grid-template-columns: 1fr 1fr; row-gap: var(--espace-8); }
  .cristal__fixe img { grid-column: 1 / -1; width: 100%; height: auto; display: block; }
  .cristal__fixe span {
    text-align: center; font-family: var(--font-mono); font-size: 11px; font-weight: 500;
    letter-spacing: .12em; text-transform: uppercase; color: var(--texte-label);
  }

  /* Mobile : image fixe seulement, à son format. */
  @media (max-width: 767px) {
    .cristal { aspect-ratio: auto; max-width: 320px; }
    .cristal :global(.cristal__toile) { display: none; }
    .cristal.est-3d .cristal__fixe { visibility: visible; }
  }
</style>
